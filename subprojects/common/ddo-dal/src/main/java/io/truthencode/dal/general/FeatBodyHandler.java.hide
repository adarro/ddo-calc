package io.truthencode.dal.general;


import com.fasterxml.jackson.core.JsonFactory;
import com.fasterxml.jackson.core.JsonParser;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import io.quarkus.logging.Log;
import jakarta.ws.rs.WebApplicationException;
import jakarta.ws.rs.core.MediaType;
import jakarta.ws.rs.core.MultivaluedMap;
import jakarta.ws.rs.ext.MessageBodyReader;
import jakarta.ws.rs.ext.Provider;
import org.jboss.resteasy.reactive.server.spi.ResteasyReactiveResourceInfo;
import org.jboss.resteasy.reactive.server.spi.ServerMessageBodyWriter;
import org.jboss.resteasy.reactive.server.spi.ServerRequestContext;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.lang.annotation.Annotation;
import java.lang.reflect.Type;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;

@Provider
public class FeatBodyHandler implements MessageBodyReader<Feat>,
    ServerMessageBodyWriter<Feat> {

    @Override
    public boolean isWriteable(Class<?> type, Type genericType,
                               Annotation[] annotations, MediaType mediaType) {
        Log.warn("FeatBodyHandler.isWriteable called");
        Log.warn("checking type " + type + " == Feat");
        return type == Feat.class;
    }

    @Override
    public void writeTo(Feat t, Class<?> type, Type genericType,
                        Annotation[] annotations, MediaType mediaType,
                        MultivaluedMap<String, Object> httpHeaders,
                        OutputStream entityStream)
        throws IOException, WebApplicationException {
        Log.warn("FeatBodyHandler.writeTo called\n checking type " + type + " == Feat");
        entityStream.write(("[FeatV1]" + t.name)
            .getBytes(StandardCharsets.UTF_8));
    }

    @Override
    public boolean isReadable(Class<?> type, Type genericType,
                              Annotation[] annotations, MediaType mediaType) {
        Log.warn("FeatBodyHandler.isReadable called\n checking type " + type + " == Feat");
        return type == Feat.class;
    }

    @Override
    public Feat readFrom(Class<Feat> type, Type genericType,
                         Annotation[] annotations, MediaType mediaType,
                         MultivaluedMap<String, String> httpHeaders,
                         InputStream entityStream)
        throws IOException, WebApplicationException {
        String body = new String(entityStream.readAllBytes(), StandardCharsets.UTF_8);
        // body should be JSON value of Feat with any key or updated values included.  So we need to push the supplied keys into the headers.
        ObjectMapper mapper = new ObjectMapper();
        JsonFactory factory = mapper.getFactory();
        JsonParser jp = factory.createParser(body);
        JsonNode actualObj = mapper.readTree(jp);
        List<String> headers = new ArrayList<>();
        actualObj.fieldNames().forEachRemaining(headers::add);
        String headersString = String.join(",", headers);
        Log.warn("Adding header UPDATE-FIELDS:" + headersString);
        httpHeaders.put("X-UPDATE-FIELDS", headers);

        Log.warn("FeatBodyHandler.readFrom called\n checking type " + type + " == Feat");
        if (body.startsWith("[FeatV1]")) {
            return new Feat(body.substring(11));
        } else {
            Log.warn("Throwing exception for " + body + " where type is claiming " + type);

            throw new IOException("Invalid Feat: " + body);
        }


    }

    @Override
    public boolean isWriteable(Class<?> type, Type genericType, ResteasyReactiveResourceInfo target, MediaType mediaType) {
        Log.warn("isWriteable type " + type + " genericType " + genericType + " target " + target + " mediaType " + mediaType);
        return type == Feat.class;
    }

    @Override
    public void writeResponse(Feat o, Type genericType, ServerRequestContext context) throws WebApplicationException, IOException {
        Log.warn("writeResponse called");
        context.serverResponse().end("[FeatV1]" + o.name);
    }

    //    @Override
//    public boolean isWriteable(Class<?> type, ResteasyReactiveResourceInfo target,
//                               MediaType mediaType) {
//        return type == Feat.class;
//    }
//
//    @Override
//    public void writeResponse(Feat t, ServerRequestContext context)
//        throws WebApplicationException, IOException {
//        context.serverResponse().end("[FeatV1]" + t.name);
//    }
}